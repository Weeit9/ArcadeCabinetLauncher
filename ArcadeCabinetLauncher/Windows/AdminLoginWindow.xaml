<Window x:Class="ArcadeCabinetLauncher.Windows.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Width="300"
        Height="300"
        WindowStartupLocation="CenterOwner"
        Background="#1b1c1c">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Grid.RenderTransform>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>

                            <DoubleAnimation
                        Storyboard.TargetName="Root"
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.15"/>

                            <DoubleAnimation
                        Storyboard.TargetName="Root"
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                        From="0.95"
                        To="1"
                        Duration="0:0:0.15"/>

                            <DoubleAnimation
                        Storyboard.TargetName="Root"
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                        From="0.95"
                        To="1"
                        Duration="0:0:0.15"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Admin Login"
                       Style="{StaticResource TextBlockStyle}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Username" Style="{StaticResource TextBlockStyle}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Password" Style="{StaticResource TextBlockStyle}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OtherButtonStyle}"
                        Width="80"
                        Height="40"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />

                <Button Content="Login"
                        Style="{StaticResource GreenButtonStyle}"
                        Width="80"
                        Height="40"
                        Click="Login_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>